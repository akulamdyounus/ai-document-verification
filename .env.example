# ==========================================
# Backend Configuration (Local & Production)
# ==========================================

# Server Settings (0.0.0.0 binds to all interfaces in Docker/Render)
HOST=0.0.0.0
PORT=8000
DEBUG=False
ENVIRONMENT=production

# Database (Leave blank to use default SQLite at database/app.db, or provide PostgreSQL URL)
# Example PostgreSQL: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=

# File Constraints
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png

# Tesseract OCR Executable Path
# Leave empty for automatic auto-detection on Windows, Linux, and Docker
# Manual Windows override example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Manual Linux override example: /usr/bin/tesseract
TESSERACT_PATH=

# CORS Configuration
# Comma-separated allowed origins (all *.vercel.app origins are also matched automatically)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173
